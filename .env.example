# ---- core ----
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://localhost:5432/myshop
# Supabase: pooler URL (port 6543) above, direct URL (port 5432) below for migrations
DATABASE_DIRECT_URL=
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=16croemer.stem@gmail.com

# ---- Auth0 (creators). Leave blank locally → /dev/login bypass ----
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# ---- Storage: Supabase Storage (fastest) OR AWS S3. Leave both blank locally → files under .data/ ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AWS S3 (takes precedence over Supabase when set) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_FILES=visitmyshop-files
S3_BUCKET_PUBLIC=visitmyshop-public
S3_PUBLIC_BASE_URL=

# ---- Resend. Leave blank locally → /dev/outbox ----
RESEND_API_KEY=
EMAIL_FROM="visitmy.shop <hello@visitmy.shop>"

# ---- Stripe platform account with Connect (Standard) enabled ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
# Our own subscription billing (creator pays us). Second Stripe webhook, "your account" events → /api/webhooks/billing.
# Optional: checkout/portal work without it; only the webhook needs it.
STRIPE_BILLING_WEBHOOK_SECRET=

# ---- PayPal Commerce Platform (partner) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_ENV=sandbox

# ---- Meta ----
META_PIXEL_ID=
GA_MEASUREMENT_ID=G-BQJ8RLRS8G
META_CAPI_TOKEN=

# ---- Instagram API with Instagram Login (keyword auto-replies) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Instagram: "true" once Meta App Review passes; "false" (default) = beta, apply-only
INSTAGRAM_PUBLIC=false
